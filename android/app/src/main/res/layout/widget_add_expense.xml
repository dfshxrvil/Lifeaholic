  android:orientation="vertical" android:background="@drawable/widget_background" android:padding="10dp">
  <TextView android:layout_width="54dp" android:layout_height="54dp" android:background="@drawable/widget_checkbox"
    android:gravity="center" android:text="+" android:textColor="#FFF0B429" android:textSize="34sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp"
    android:gravity="center" android:text="Add Expense" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
