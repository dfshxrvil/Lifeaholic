<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="13dp" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageButton android:id="@+id/task_checkbox" android:layout_width="12dp" android:layout_height="12dp"
    android:background="@drawable/widget_checkbox" android:contentDescription="Complete task" android:padding="0dp"/>
  <TextView android:id="@+id/task_title" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:layout_marginStart="3dp" android:ellipsize="end" android:maxLines="1"
    android:includeFontPadding="false" android:textColor="#FFFFFFFF" android:textSize="8sp" android:textStyle="bold"/>
</LinearLayout>
