<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical"
  android:orientation="horizontal" android:background="@drawable/widget_tile" android:paddingHorizontal="10dp">
  <TextView android:id="@+id/subject_name" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFFFF"
    android:textSize="13sp" android:textStyle="bold"/>
  <TextView android:id="@+id/subject_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginStart="8dp" android:textColor="#FFF0B429" android:textSize="11sp" android:textStyle="bold"/>
</LinearLayout>
